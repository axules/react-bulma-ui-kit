{
  "name": "react-bulma-ui-kit",
  "version": "1.20.1",
  "description": "UI kit based on bulma css framework for react",
  "repository": {
    "type": "git",
    "url": "https://github.com/axules/react-bulma-ui-kit"
  },
  "exports": {
    "./*": "./lib/*.js",
    "./components/*": "./lib/components/*.js",
    "./c/*": "./lib/components/*.js"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "jest",
    "eslint": "eslint ./ --ext=js,jsx",
    "build": "npm run app-build && npm run docs-build",
    "app-build": "cross-env NODE_ENV=production babel --source-maps --delete-dir-on-start -d lib src -x .js,.jsx",
    "docs-build": "cross-env NODE_ENV=doc node ./docsSrc/build.js"
  },
  "keywords": [
    "ui-kit",
    "bulma",
    "react"
  ],
  "author": {
    "name": "Shelest Denis",
    "email": "axules@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "classnames": "2.x"
  },
  "peerDependencies": {
    "react": "18 - 19",
    "react-dom": "18 - 19"
  },
  "devDependencies": {
    "@babel/cli": "8.0.4",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/eslint-plugin": "8.0.1",
    "@babel/plugin-proposal-export-default-from": "8.0.1",
    "@babel/plugin-proposal-pipeline-operator": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@parcel/css": "1.14.0",
    "babel-jest": "30.4.1",
    "babel-loader": "10.1.1",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "bulma": "1.0.4",
    "core-js": "3.49.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.4",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "10.5.0",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.0-beta.5",
    "globals": "17.7.0",
    "eslint-plugin-es": "4.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-newlines": "2.0.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-presets": "github:axules/eslint-presets#master",
    "html-webpack-plugin": "5.6.7",
    "jest": "30.4.2",
    "lodash.debounce": "4.0.8",
    "mini-css-extract-plugin": "2.10.2",
    "postcss-loader": "8.2.1",
    "postcss-normalize": "13.0.1",
    "prop-types": "15.8.1",
    "react-dom": "19.2.7",
    "sass": "1.101.0",
    "sass-loader": "17.0.0",
    "sass-resources-loader": "2.2.5",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.108.4",
    "webpack-bundle-analyzer": "5.3.1",
    "webpack-cli": "7.2.1",
    "webpack-dashboard": "3.3.8",
    "webpack-dev-middleware": "8.0.3",
    "webpack-hot-middleware": "2.26.1"
  },
  "overrides": {
    "eslint": "10.5.0"
  }
}
